# ============================================================
# 謝天地的修道丹心 · 環境變數設定範例
# 複製此檔案為 .env.local 並填入實際值
# ============================================================

# ── Supabase ─────────────────────────────────────────────
# 至 https://supabase.com/dashboard → 您的專案 → Settings → API 取得
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key

# ── LINE LIFF ─────────────────────────────────────────────
# 至 https://developers.line.biz → 您的 Channel → LIFF 分頁取得
VITE_LIFF_ID=2010848952-VfGV0qlc

# ── LINE OA Webhook（line-webhook 伺服器使用）────────────
# Channel Access Token：LINE Developers → Messaging API → Channel access token
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token
# Channel Secret：LINE Developers → Basic settings → Channel secret
LINE_CHANNEL_SECRET=your_channel_secret

# ── 推播安全金鑰（自行設定一組隨機字串）────────────────
# 用於保護 /push-article API，防止未授權呼叫
PUSH_SECRET=your_random_push_secret_string

# ── 網站 URL ─────────────────────────────────────────────
SITE_URL=https://your-vercel-domain.vercel.app
