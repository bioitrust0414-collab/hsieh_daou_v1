{
  "version": 2,
  "builds": [
    {
      "src": "line-webhook/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/webhook",
      "dest": "/line-webhook/index.js"
    },
    {
      "src": "/push-article",
      "dest": "/line-webhook/index.js"
    },
    {
      "src": "/health",
      "dest": "/line-webhook/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
